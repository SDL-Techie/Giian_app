# Server
PORT=4000
NODE_ENV=development
TRUST_PROXY=1

# MongoDB
# Production: use MongoDB Atlas or a replica set because financial operations use transactions.
DB_URL=mongodb://localhost:27017/salesmanagement
DB_SERVER_SELECTION_TIMEOUT_MS=10000
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=0
ALLOW_NON_TRANSACTIONAL_DEV=true

# Auth - use a cryptographically random secret of at least 32 characters in production
JWT_SECRET=crmsalesmanagementsecretjwt
JWT_EXPIRE=30m
EXPIRE_COOKIE=1
COOKIE_SAME_SITE=lax

# Initial one-time administrator bootstrap
# Required only when no admin exists. Remove BOOTSTRAP_ADMIN_PASSWORD from deployment secrets after first successful login/password change.
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@12345

# Browser frontend origins, comma-separated. React Native/Postman requests without Origin are allowed.
CLIENT_URL=http://localhost:3000

# Security / limits
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
JSON_BODY_LIMIT=2mb
MAX_UPLOAD_MB=10

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PDF_COMPRESSOR_PATH=gs
PDF_COMPRESSION_REQUIRED=true

PDF_TARGET_KB=80


PDF_COMPRESSION_TIMEOUT_MS=45000

